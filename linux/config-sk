
# Enable NTSync module
CONFIG_NTSYNC=y

# Disable nouveau module
CONFIG_DRM_NOUVEAU=n

# Disable radeon module
CONFIG_DRM_RADEON=n

# PARAVIRT options have overhead, even on bare metal boots. They can cause
# spinlocks to not be inlined as well. Either way, we don't intend to run this
# kernel as a guest, so this also clears out a whole bunch of
# virtualization-specific drivers.
CONFIG_HYPERVISOR_GUEST=n

# As running as a guest is not allowed disable guest drivers too
CONFIG_VIRT_DRIVERS=n
CONFIG_DRM_QXL=n

# Disable xen virtualization
CONFIG_XEN_PCIDEV_BACKEND=n
CONFIG_XEN_ACPI_PROCESSOR=n
CONFIG_XEN_MCE_LOG=n
CONFIG_XEN_PVHVM_GUEST=n
CONFIG_XEN_PVHVM_SMP=n
CONFIG_XEN_PVHVM=n
CONFIG_XEN_PVH=n

# AGP GPUs are not supported
CONFIG_AGP=n

# Old unsupported GPU
CONFIG_DRM_MGAG200=n

# There is no use for SELinux as it requires a full userspace rebuild
CONFIG_SECURITY_SELINUX=n

# SkorionOS is a gaming-oriented distro and chemical sensors are not a good fit
CONFIG_AOSONG_AGS02MA=n
CONFIG_ATLAS_PH_SENSOR=n
CONFIG_ATLAS_EZO_SENSOR=n
CONFIG_BME680=n
CONFIG_BME680_I2C=n
CONFIG_BME680_SPI=n
