# sk-Chimera / SkorionOS specific config flags

# Android
CONFIG_ASHMEM=y
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES=""
CONFIG_STAGING=y
CONFIG_ANDROID_BINDER_IPC_SELFTEST=n

# cjktty
CONFIG_FONT_CJK_16x16=y
CONFIG_FONT_CJK_32x32=y

CONFIG_MODVERSIONS=y

# Handheld HID (OGC/ogc-7.2.y Kconfig symbols)
CONFIG_HID_ASUS_ALLY=m
CONFIG_HID_OXP=m
CONFIG_HID_LENOVO_GO=m
CONFIG_HID_LENOVO_GO_S=m
CONFIG_HID_MSI=m

# Handheld platform / audio (formerly pulled via config-bazzite)
CONFIG_SND_SOC_AW87XXX=m
CONFIG_AYN_EC=m

# Steam Deck EC/MFD (present in OGC tree; keep for Deck-class devices)
CONFIG_MFD_STEAMDECK=m
CONFIG_SENSORS_STEAMDECK=m
CONFIG_LEDS_STEAMDECK=m
CONFIG_EXTCON_STEAMDECK=m

CONFIG_NTFS_FS=m
